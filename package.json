{
  "name": "engistore-pro",
  "version": "2.3.0",
  "description": "Engineering Purchase & Inventory Software",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bmlparenteral.engistore",
    "productName": "EngiStore Pro",
    "icon": "icon.ico",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EngiStore Pro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shibumonpvs73-prog",
        "repo": "EngiStore-Pro",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
